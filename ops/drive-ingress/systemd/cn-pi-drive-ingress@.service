[Unit]
Description=Materialize Pi Drive staging for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/cmp
Environment=CN_PI_INGRESS_SOURCE_MODE=auto
Environment=CN_PI_INGRESS_RCLONE_CONFIG=/root/.config/rclone/rclone.conf
Environment=CN_PI_INGRESS_PROJECT=%i
Environment=CN_PI_INGRESS_DIRECTION=drive-to-git
ExecStart=/usr/local/libexec/cn-pi-drive-ingress
TimeoutStartSec=180s
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/cn-pi-clone/.git /root/cmp/.git /root/tsc/.git /root/cnos/.git /run/lock /var/lib/cn-pi-drive-ingress
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=128M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
