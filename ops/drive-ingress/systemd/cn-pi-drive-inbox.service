[Unit]
Description=Deliver addressed Git dialogue and bridge health to Pi Drive inbox
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/cmp
Environment=CN_PI_INGRESS_SOURCE_MODE=auto
Environment=CN_PI_INGRESS_RCLONE_CONFIG=/root/.config/rclone/rclone.conf
Environment=CN_PI_INGRESS_PROJECT=all
Environment=CN_PI_INGRESS_DIRECTION=git-to-drive
ExecStart=/usr/local/libexec/cn-pi-drive-ingress
TimeoutStartSec=180s
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/cmp/.git /root/tsc/.git /root/cnos/.git /root/cn-sigma/.git /root/cn-omega/.git /run/lock /var/lib/cn-pi-drive-ingress
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=128M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
